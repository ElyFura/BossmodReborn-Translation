<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>ElyFura</Authors>
    <Version>0.1.0.1</Version>
    <Description>German translation layer for BossMod Reborn.</Description>
    <AssemblyName>BmrTranslation</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Pin the output to bin\x64\Release regardless of how Platform resolves: a solution build does not
         propagate x64 down to the project, so relying on AppendPlatformToOutputPath moves the DLL out from
         under the registered Dalamud dev-plugin path. -->
    <BaseOutputPath>bin\x64\</BaseOutputPath>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Reflection" />
    <Using Include="System.Text" />
  </ItemGroup>

  <PropertyGroup>
    <HarmonyVersion>2.4.2</HarmonyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <!-- DALAMUD_HOME wins wherever it is set, not just on Linux: a CI runner has no XIVLauncher
         installation to read from, and it lets a developer build against a specific Dalamud without
         moving the one they play with. -->
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DalamudPackager" Version="15.0.0" />
    <!-- Combat hints are string literals inside 800+ call sites; only IL patching reaches them.
         ExcludeAssets="runtime": Harmony must NOT end up beside the plugin, because Dalamud would then
         load it into the plugin's collectible context, where every Patch() call fails. It is embedded
         below and pushed into the default context at startup instead - see Interop/HarmonyBootstrap.cs. -->
    <PackageReference Include="Lib.Harmony" Version="$(HarmonyVersion)" ExcludeAssets="runtime" />
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json">
      <LogicalName>BmrTranslation.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Harmony travels inside the plugin assembly rather than next to it. Taken straight from the
       restored package so the version is stated once, at the PackageReference above. -->
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)lib.harmony\$(HarmonyVersion)\lib\net10.0\0Harmony.dll">
      <LogicalName>BmrTranslation.0Harmony.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Checked at the source rather than on the output directory: a copy next to the plugin lands in the
       collectible load context, where every Harmony patch fails. ReferenceCopyLocalPaths is what would
       put it there, so dropping ExcludeAssets="runtime" fails the build instead of shipping quietly. -->
  <Target Name="VerifyHarmonyEmbedded" AfterTargets="ResolveReferences">
    <Error Condition="!Exists('$(NuGetPackageRoot)lib.harmony\$(HarmonyVersion)\lib\net10.0\0Harmony.dll')" Text="0Harmony.dll not found in the package cache - it must be embedded (see Interop/HarmonyBootstrap.cs)" />
    <Error Condition="'@(ReferenceCopyLocalPaths->AnyHaveMetadataValue('Filename', '0Harmony'))' == 'true'" Text="0Harmony.dll would be copied next to the plugin; Dalamud loads it into the plugin's collectible context and every patch fails. Keep ExcludeAssets=&quot;runtime&quot; on the PackageReference." />
  </Target>

  <Target Name="CleanupOutput" AfterTargets="Build">
    <ItemGroup>
      <!-- 0Harmony.dll is deliberately absent from the output: it is embedded, and a copy lying here
           would be found by the plugin's collectible load context and break every patch -->
      <_ExtraOutputFiles Include="$(OutputPath)*" Exclude="$(OutputPath)BmrTranslation.*" />
    </ItemGroup>
    <Delete Files="@(_ExtraOutputFiles)" />
  </Target>

  <!-- The installable artefact. DependsOnTargets, not just AfterTargets: both hang off Build, and the
       zip has to be taken after the output directory is cleaned, or it ships the build clutter. -->
  <Target Name="PackagePlugin" AfterTargets="Build" DependsOnTargets="CleanupOutput" Condition="'$(Configuration)' == 'Release'">
    <DalamudPackager ProjectDir="$(ProjectDir)" OutputPath="$(OutputPath)" AssemblyName="$(AssemblyName)" MakeZip="true" VersionComponents="4" />
  </Target>
</Project>
